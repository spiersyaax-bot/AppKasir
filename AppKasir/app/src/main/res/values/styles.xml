<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:textColorPrimary">@color/primary_text</item>
        <item name="android:textColorSecondary">@color/secondary_text</item>
    </style>

    <style name="Widget.App.Button.Primary" parent="Widget.AppCompat.Button">
        <item name="android:background">@color/accent</item>
        <item name="android:textColor">@android:color/white</item>
    </style>

    <style name="Widget.App.Fab" parent="@style/Widget.Design.FloatingActionButton">
        <item name="android:backgroundTint">@color/accent</item>
        <item name="android:tint">@android:color/white</item>
    </style>

    <style name="Widget.App.Badge" parent="TextAppearance.AppCompat.Body2">
        <item name="android:background">@color/highlight</item>
        <item name="android:textColor">@color/primary</item>
    </style>

</resources>
